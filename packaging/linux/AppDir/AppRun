#
# Runtime strategy: build_appimage.sh uses an isolated venv only as a build
# environment and freezes Python, Qt and Reduvid with PyInstaller into
# usr/lib/Reduvid. The frozen launcher starts reduvid.gui.app with the bundled
# interpreter, so the system Python is not needed; FFmpeg is left external.

set -euo pipefail

HERE=$(dirname "$(readlink -f "${0}")")
export PATH="$HERE/usr/bin:${PATH:-}"
APP="$HERE/usr/lib/Reduvid/Reduvid"

if [[ ! -x "$APP" ]]; then
    echo "Reduvid executable not found: $APP" >&2
    exit 1
fi

exec "$APP" "$@"
