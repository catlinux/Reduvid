msgstr ", {language}"

#: cli.py:209
#, python-brace-format
msgid "Audio stream {index}: {details}"
msgstr "Pista d'àudio {index}: {details}"

#: messages.py:28
#, python-brace-format
msgid "Audio track {stream_index} will be converted to {codec} so that Jellyfin can play it directly."
msgstr ""
"La pista d'àudio {stream_index} es convertirà a {codec} perquè el Jellyfin la pugui reproduir "
"directament."

#: cli.py:155
#, python-brace-format
msgid "Audio {position}: {codec}, {channels} channels{language}"
msgstr "Àudio {position}: {codec}, {channels} canals{language}"

#: cli.py:371
msgid "Convert media files"
msgstr "Converteix fitxers multimèdia"

#: cli.py:244
#, python-brace-format
msgid "Converting [{index}/{total}]: {path}"
msgstr "Convertint [{index}/{total}]: {path}"

#: cli.py:347
msgid "Dry run complete."
msgstr "Simulació completada."

#: cli.py:287
#, python-brace-format
msgid "Dry run: {count} file(s)"
msgstr "Simulació: {count} fitxer(s)"

#: cli.py:128
#, python-brace-format
msgid "Duration: {duration}"
msgstr "Durada: {duration}"

#: cli.py:99
#, python-brace-format
msgid "Error: Could not inspect FFmpeg: {error}"
msgstr "Error: no s'ha pogut inspeccionar FFmpeg: {error}"

#: cli.py:234 cli.py:293
#, python-brace-format
msgid "Error: Could not probe {path}: {error}"
msgstr "Error: no s'ha pogut analitzar {path}: {error}"

#: cli.py:74
#, python-brace-format
msgid "Error: Could not resolve input {path}: {error}"
msgstr "Error: no s'ha pogut resoldre l'entrada {path}: {error}"

#: cli.py:102
msgid "Error: FFmpeg and ffprobe were not found."
msgstr "Error: no s'han trobat FFmpeg ni ffprobe."

#: cli.py:82
#, python-brace-format
msgid "Error: Input does not exist: {path}"
msgstr "Error: l'entrada no existeix: {path}"

#: cli.py:88
#, python-brace-format
msgid "Error: Input is not a supported file or folder: {path}"
msgstr "Error: l'entrada no és un fitxer ni una carpeta compatible: {path}"

#: cli.py:415
#, python-brace-format
msgid "Error: Output path is not a folder: {path}"
msgstr "Error: la ruta de sortida no és una carpeta: {path}"

#: cli.py:405
#, python-brace-format
msgid "Error: Probe input is not a file: {path}"
msgstr "Error: l'entrada d'anàlisi no és un fitxer: {path}"

#: cli.py:264
#, python-brace-format
msgid "Error: {path}{details}"
msgstr "Error: {path}{details}"

#: cli.py:126
#, python-brace-format
msgid "File: {path}"
msgstr "Fitxer: {path}"

#: cli.py:269
#, python-brace-format
msgid "Files: {succeeded} succeeded, {failed} failed, {skipped} skipped"
msgstr "Fitxers: {succeeded} correctes, {failed} amb error, {skipped} omesos"

#: cli.py:258
#, python-brace-format
msgid "Finished: {name}"
msgstr "Acabat: {name}"

#: cli.py:127
#, python-brace-format
msgid "Format: {format}"
msgstr "Format: {format}"

#: messages.py:36
#, python-brace-format
msgid "Image subtitle track {stream_index} cannot be stored in MP4 and will be removed."
msgstr "La pista de subtítols d'imatge {stream_index} no es pot guardar en MP4 i se suprimirà."

#: messages.py:32
#, python-brace-format
msgid "Image subtitle track {stream_index} will have to be converted while playing, which uses more CPU."
msgstr ""
"La pista de subtítols d'imatge {stream_index} s'haurà de convertir durant la reproducció, cosa "
"que consumeix més CPU."

#: cli.py:366
msgid "Language for messages"
msgstr "Idioma dels missatges"

#: messages.py:39
msgid "No audio track matches the selected languages, so all of them will be kept."
msgstr "Cap pista d'àudio no coincideix amb els idiomes seleccionats, així que es conservaran totes."

#: cli.py:301 cli.py:327
#, python-brace-format
msgid "Output: {path}"
msgstr "Sortida: {path}"

#: cli.py:181
#, python-brace-format
msgid "Plan: {destination}, {quality}, {container}"
msgstr "Pla: {destination}, {quality}, {container}"

#: cli.py:253
#, python-brace-format
msgid "Progress: {percent:.0f}% ({state})"
msgstr "Progrés: {percent:.0f}% ({state})"

#: cli.py:369
msgid "Show media details"
msgstr "Mostra els detalls del multimèdia"

#: cli.py:129
#, python-brace-format
msgid "Size: {size:.2f} MB"
msgstr "Mida: {size:.2f} MB"

#: messages.py:69
msgid "Something went wrong while processing the file."
msgstr "Hi ha hagut un problema en processar el fitxer."

#: cli.py:219
#, python-brace-format
msgid "Subtitle stream {index}: {details}"
msgstr "Pista de subtítols {index}: {details}"

#: cli.py:170
#, python-brace-format
msgid "Subtitle {position}: {codec}{language}, image: {image}"
msgstr "Subtítol {position}: {codec}{language}, imatge: {image}"

#: messages.py:62
msgid "The conversion was cancelled."
msgstr "S'ha cancel·lat la conversió."

#: messages.py:64
msgid "The converted file did not pass the safety checks and was discarded."
msgstr "El fitxer convertit no ha superat les comprovacions de seguretat i s'ha descartat."

#: messages.py:55
msgid "The file appears to be damaged and could not be read."
msgstr "El fitxer sembla malmès i no s'ha pogut llegir."

#: messages.py:67
msgid "The file could not be analysed. It may be damaged or in an unsupported format."
msgstr "No s'ha pogut analitzar el fitxer. Pot ser que estigui malmès o en un format no compatible."

#: messages.py:60
msgid "The file or folder cannot be read or written because of a permissions problem."
msgstr "No es pot llegir o escriure el fitxer o la carpeta per un problema de permisos."

#: messages.py:54
msgid "There is not enough free space on the destination drive."
msgstr "No hi ha prou espai lliure al disc de destinació."

#: messages.py:57
msgid "This FFmpeg installation is missing an encoder that is needed to convert the file."
msgstr "Aquesta instal·lació de FFmpeg no té un codificador necessari per convertir el fitxer."

#: cli.py:275
#, python-brace-format
msgid "Total savings: {savings:.2f} MB ({percent:.1f}%)"
msgstr "Estalvi total: {savings:.2f} MB ({percent:.1f}%)"

#: messages.py:44 messages.py:48
#, python-brace-format
msgid "Unknown warning: {code}"
msgstr "Avís desconegut: {code}"

#: cli.py:195
#, python-brace-format
msgid "Video stream {index}: {action}, {details}"
msgstr "Pista de vídeo {index}: {action}, {details}"

#: messages.py:24
#, python-brace-format
msgid "Video track {stream_index} is HDR and this FFmpeg installation cannot convert it to SDR."
msgstr "La pista de vídeo {stream_index} és HDR i aquesta versió de FFmpeg no la pot convertir a SDR."

#: messages.py:20
#, python-brace-format
msgid ""
"Video track {stream_index} is HDR and will be converted to SDR; colours may look slightly "
"different."
msgstr "La pista de vídeo {stream_index} és HDR i es convertirà a SDR; els colors poden variar una mica."

#: messages.py:16
#, python-brace-format
msgid "Video track {stream_index} will be scaled down to 1080p so that Jellyfin can play it directly."
msgstr ""
"La pista de vídeo {stream_index} es reduirà a 1080p perquè el Jellyfin la pugui reproduir "
"directament."

#: cli.py:137
#, python-brace-format
msgid "Video {position}: {codec}, {width}x{height}, {fps:g} fps, {depth}-bit, HDR {hdr}"
msgstr "Vídeo {position}: {codec}, {width}x{height}, {fps:g} fps, {depth} bits, HDR {hdr}"

#: cli.py:43
#, python-brace-format
msgid "Warning: Could not read config file: {error}"
msgstr "Avís: no s'ha pogut llegir el fitxer de configuració: {error}"

#: cli.py:224
#, python-brace-format
msgid "Warning: {text}"
msgstr "Avís: {text}"

